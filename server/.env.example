# MongoDB connection string (Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb://127.0.0.1:27017/picklepro
# Host login password. Use a long random one in production.
ADMIN_PASSWORD=change-me
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PORT=4000
# Number of proxies in front of the server (Render = 1). Used for login rate limiting.
TRUST_PROXY=1
